{
  "name": "@swufefox/ak-ui-react",
  "version": "1.2.0",
  "description": "Arknights-inspired design system for React — tokens, CSS primitives and components ported from @yunyoujun/ak-ui.",
  "keywords": [
    "ak-ui",
    "arknights",
    "design-system",
    "design-tokens",
    "react",
    "react-components",
    "typescript",
    "ui"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwufeFox/ak-ui-react.git"
  },
  "bugs": {
    "url": "https://github.com/SwufeFox/ak-ui-react/issues"
  },
  "homepage": "https://github.com/SwufeFox/ak-ui-react#readme",
  "author": "SwufeFox <42512131@smail.swufe.edu.cn>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./core": {
      "types": "./dist/core/site.d.mts",
      "import": "./dist/core/site.mjs",
      "default": "./dist/core/site.mjs"
    },
    "./core/effects": {
      "types": "./dist/core/effects.d.mts",
      "import": "./dist/core/effects.mjs",
      "default": "./dist/core/effects.mjs"
    },
    "./core/depth": {
      "types": "./dist/core/dashboard-depth.d.mts",
      "import": "./dist/core/dashboard-depth.mjs",
      "default": "./dist/core/dashboard-depth.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
